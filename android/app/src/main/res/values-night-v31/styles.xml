<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31+) 系统 Splash（暗色模式）：
         黑色背景，与亮色版白色保持一致的产品逻辑：开屏跟随系统明暗。 -->
