<?xml version="1.0" encoding="utf-8"?>
<!-- 开屏背景（API 21+）：白/黑（跟随系统，values-night 自动覆盖）+ 居中彩色 Logo，覆盖 Flutter 引擎就绪前的加载期。
     引擎首帧绘制后系统自动移除，无白屏、无额外延时。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_splash_bg" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
